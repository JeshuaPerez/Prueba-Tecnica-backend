{
  "name": "polizas-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API de consulta e importación de pólizas aduaneras con PostgreSQL",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node scripts/init-db.js",
    "csv:import": "node scripts/import-csv.js",
    "check": "node --check src/server.js && node --check scripts/import-csv.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "pg": "^8.13.1"
  }
}
