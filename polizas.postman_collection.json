{
  "info": {
    "name": "Polizas API - Demo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{ "key": "base", "value": "http://localhost:3000" }],
  "item": [
    { "name": "0. Health check", "request": { "method": "GET", "url": "{{base}}/health" } },
    { "name": "1. Listar pólizas (paginado)", "request": { "method": "GET", "url": "{{base}}/api/v1/importaciones?page=1&limit=2" } },
    { "name": "2. Póliza por correlativo", "request": { "method": "GET", "url": "{{base}}/api/v1/importaciones/32642260" } },
    { "name": "3. Pólizas que contienen un SAC", "request": { "method": "GET", "url": "{{base}}/api/v1/sac/8504400000" } },
    { "name": "4. Estadísticas por país", "request": { "method": "GET", "url": "{{base}}/api/v1/estadisticas/por-pais" } },
    { "name": "5. Estadísticas por aduana", "request": { "method": "GET", "url": "{{base}}/api/v1/estadisticas/por-aduana" } },
    { "name": "ERR 404 - póliza inexistente", "request": { "method": "GET", "url": "{{base}}/api/v1/importaciones/999" } },
    { "name": "ERR 400 - correlativo con letras", "request": { "method": "GET", "url": "{{base}}/api/v1/importaciones/abc" } },
    { "name": "ERR 400 - limit fuera de rango", "request": { "method": "GET", "url": "{{base}}/api/v1/importaciones?limit=500" } },
    { "name": "ERR 404 - ruta inexistente", "request": { "method": "GET", "url": "{{base}}/api/v1/no-existe" } }
  ]
}
